# =============================================================================
# vnvacaciones — Frontend Dockerfile
# Stage 1: build con Bun
# Stage 2: serve con Nginx
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — Build
# -----------------------------------------------------------------------------
FROM oven/bun:1.3-alpine AS builder

WORKDIR /app

# Copiar manifiestos primero (capa cacheada si no cambian deps)
COPY package.json bun.lockb ./

# Instalar dependencias
RUN bun install

# Copiar el resto del código
COPY . .

# Build args para las variables de entorno de Vite
# Se inyectan en tiempo de build (quedan embebidas en el bundle JS)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_SUPABASE_PROJECT_ID=local

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_PROJECT_ID=$VITE_SUPABASE_PROJECT_ID

# Producir el build estático en /app/dist
RUN bun run build

# -----------------------------------------------------------------------------
# Stage 2 — Serve con Nginx
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production

# Copiar el build del stage anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuración de Nginx
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Puerto estándar
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
